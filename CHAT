Step 5: src/api.js (API Service)
Create a new file src/api.js:

JavaScript
import axios from 'axios';

// Pointing to your ASP.NET Core API running on port 5000
const API_BASE_URL = 'http://localhost:5000/api/plant';

// Fetch current live tag readings from PostgreSQL via C# API
export const fetchLiveReadings = async () => {
  const response = await axios.get(`${API_BASE_URL}/live`);
  return response.data;
};

// Fetch 24-hour historical telemetry trend points
export const fetchTagHistory = async (tagId, hours = 24) => {
  const response = await axios.get(`${API_BASE_URL}/history`, {
    params: { tagId, hours }
  });
  return response.data;
};
