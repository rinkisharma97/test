Step 7: src/App.jsx (Single-Page Dashboard Component)
Replace src/App.jsx (and delete src/App.tsx if it exists):

JavaScript
import { useEffect, useState } from 'react';
import { fetchLiveReadings, fetchTagHistory } from './api';
import { LineChart, Line, XAxis, YAxis, Tooltip, ResponsiveContainer } from 'recharts';
import { Activity } from 'lucide-react';
import './App.css';

export default function App() {
  const [liveTags, setLiveTags] = useState([]);
  const [selectedTag, setSelectedTag] = useState(null);
  const [history, setHistory] = useState([]);
  const [loading, setLoading] = useState(true);

  // Fetch live telemetry data
  const loadLiveData = async () => {
    try {
      const data = await fetchLiveReadings();
      setLiveTags(data);
      if (!selectedTag && data.length > 0) {
        setSelectedTag(data[0].tagId);
      }
    } catch (err) {
      console.error('Error fetching live data:', err);
    } finally {
      setLoading(false);
    }
  };

  // Refresh live tags every 3 seconds
  useEffect(() => {
    loadLiveData();
    const interval = setInterval(loadLiveData, 3000);
    return () => clearInterval(interval);
  }, []);

  // Fetch 24h trend history when tag card is clicked
  useEffect(() => {
    if (selectedTag) {
      fetchTagHistory(selectedTag, 24)
        .then(setHistory)
        .catch(console.error);
    }
  }, [selectedTag]);

  return (
    <div className="dashboard-container">
      <header className="header">
        <div className="header-title">
          <Activity size={20} color="#22c55e" />
          <h1>iNDUS Plant Monitor</h1>
        </div>
        <span className="badge-live">LIVE</span>
      </header>

      <main className="content">
        {loading ? (
          <p style={{ textAlign: 'center', marginTop: '30px', color: '#94a3b8' }}>
            Connecting to PostgreSQL API...
          </p>
        ) : (
          <>
            <div className="section-label">Active Plant Tags</div>

            <div className="tag-grid">
              {liveTags.map((tag) => (
                <div
                  key={tag.tagId}
                  className={`tag-card ${selectedTag === tag.tagId ? 'active' : ''}`}
                  onClick={() => setSelectedTag(tag.tagId)}
                >
                  <div className="tag-top-row">
                    <span>{tag.tagName}</span>
                    <span style={{ color: tag.quality === 'Good' ? '#22c55e' : '#ef4444' }}>
                      {tag.quality}
                    </span>
                  </div>
                  <div className="tag-val-row">
                    <span className="tag-val">{tag.val}</span>
                    <span className="tag-unit">{tag.unit}</span>
                  </div>
                </div>
              ))}
            </div>

            {selectedTag && history.length > 0 && (
              <div className="chart-card">
                <div className="chart-header">24h History: {selectedTag}</div>
                <div style={{ width: '100%', height: 200 }}>
                  <ResponsiveContainer>
                    <LineChart data={history}>
                      <XAxis
                        dataKey="timestamp"
                        stroke="#64748b"
                        tickFormatter={(str) =>
                          new Date(str).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                        }
                      />
                      <YAxis stroke="#64748b" domain={['auto', 'auto']} />
                      <Tooltip
                        contentStyle={{ backgroundColor: '#0f172a', borderColor: '#334155', color: '#f8fafc' }}
                        labelFormatter={(str) => new Date(str).toLocaleString()}
                        formatter={(val) => [val, 'Value']}
                      />
                      <Line type="monotone" dataKey="val" stroke="#3b82f6" strokeWidth={2} dot={false} />
                    </LineChart>
                  </ResponsiveContainer>
                </div>
              </div>
            )}
          </>
        )}
      </main>
    </div>
  );
}
